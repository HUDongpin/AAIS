[Unit]
Description=Restore AAIS runtime secrets from Alibaba Cloud KMS
Wants=network-online.target
After=network-online.target
Before=aais-email-outbox.service aais-lrs-outbox.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/aais/bin/aais-secrets-bootstrap.sh
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/aais
ReadWritePaths=/opt/aais/state
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
