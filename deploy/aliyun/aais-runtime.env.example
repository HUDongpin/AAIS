NODE_ENV=production
AAIS_DATABASE_DRIVER=pg
# Use neon/current-source during the compute-only window, then rds only after
# the private RDS rehearsal and cutover gates close.
AAIS_DATABASE_PROVIDER=
# Production Aliyun URLs must include sslmode=verify-full and the verified RDS
# hostname/CA chain, including sslrootcert=/etc/aais/rds-ca.pem. Never use an
# IP literal or sslmode=require.
AAIS_DATABASE_URL=
AAIS_DATABASE_POOL_MAX=5
AAIS_DATABASE_TARGET_ID=
AAIS_DEPLOYMENT_PROVIDER=aliyun
AAIS_RELEASE_ID=
AAIS_DEPLOYMENT_GIT_COMMIT_SHA=
# Each invocation appends a unique UUID to this stable role prefix.
AAIS_WORKER_INSTANCE_ID=aliyun:aais-primary
AAIS_APP_BASE_URL=https://www.aais.site
AAIS_TRUSTED_PROXY_IP_HEADER=x-real-ip
AAIS_RESEARCH_MODE=false
AAIS_SESSION_SECRET=
AAIS_PRODUCT_PSEUDONYM_SECRET=
AAIS_READINESS_BEARER_TOKEN=
AAIS_LRS_OUTBOX_FLUSH_TOKEN=
AAIS_AUTH_EMAIL_OUTBOX_FLUSH_TOKEN=
AAIS_AI_PROVIDER=openai-compatible
AAIS_AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AAIS_AI_API_KEY=
AAIS_AI_MODEL=
AAIS_AI_EVAL_APPROVED=
AAIS_AI_EVAL_VERSION=
AAIS_AI_EVAL_MANIFEST_SHA256=
AAIS_AI_EVAL_SIGNING_KEY_ID=
AAIS_AI_EVAL_VERIFYING_KEY_SPKI=
AAIS_AUTH_EMAIL_FROM=
RESEND_API_KEY=
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=
