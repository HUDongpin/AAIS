# Reference only. The protected production source must contain only KEY=VALUE
# records with no comments or blank lines; do not copy this annotated file.
# Registry usernames, tokens, Docker configuration, candidate receipts, and
# preload receipts never belong in this application runtime secret bundle.
NODE_ENV=production
AAIS_DATABASE_DRIVER=pg
# The existing Neon PostgreSQL 17 database is the only supported authoritative
# production target for both Aliyun and Vercel.
AAIS_DATABASE_PROVIDER=neon
# Use the dedicated Aliyun runtime role. The URL must use the Neon hostname and
# exactly one sslmode=verify-full; never use an IP literal or sslmode=require.
# Vercel uses a different least-privilege role/credential for the same target.
AAIS_DATABASE_URL=
AAIS_DATABASE_POOL_MAX=5
# Both providers use the same non-secret production target ID bound by migration
# 0029; restored/rehearsal branches must use distinct target IDs.
AAIS_DATABASE_TARGET_ID=
AAIS_SECRET_BUNDLE_VERSION=
AAIS_DEPLOYMENT_PROVIDER=aliyun
AAIS_RELEASE_ID=
AAIS_DEPLOYMENT_GIT_COMMIT_SHA=
# Each invocation appends a unique UUID to this stable role prefix.
AAIS_WORKER_INSTANCE_ID=aliyun:aais-primary
AAIS_APP_BASE_URL=https://www.aais.site
AAIS_TRUSTED_PROXY_IP_HEADER=x-real-ip
AAIS_RESEARCH_MODE=false
AAIS_RESEARCH_REQUIRED=false
AAIS_SESSION_SECRET=
AAIS_PRODUCT_PSEUDONYM_SECRET=
AAIS_READINESS_BEARER_TOKEN=
AAIS_LRS_OUTBOX_FLUSH_TOKEN=
AAIS_AUTH_EMAIL_OUTBOX_FLUSH_TOKEN=
AAIS_AI_PROVIDER=openai-compatible
AAIS_AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AAIS_AI_API_KEY=
AAIS_AI_MODEL=
AAIS_AI_EVAL_APPROVED=
AAIS_AI_EVAL_VERSION=
AAIS_AI_EVAL_MANIFEST_SHA256=
AAIS_AI_EVAL_SIGNING_KEY_ID=
AAIS_AI_EVAL_VERIFYING_KEY_SPKI=
AAIS_AUTH_EMAIL_FROM=
RESEND_API_KEY=
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=
