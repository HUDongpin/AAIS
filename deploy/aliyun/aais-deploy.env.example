# Non-secret deployment controls. Install as /etc/aais/deploy.env owned by root.
# Use the exact Enterprise instance VPC login server; do not substitute a
# Personal Edition or public legacy endpoint.
AAIS_ACR_REPOSITORY=REPLACE_ENTERPRISE_VPC_LOGIN_SERVER/REPLACE_NAMESPACE/aais
AAIS_ACR_INSTANCE_ID=REPLACE_ENTERPRISE_INSTANCE_ID
AAIS_ACR_API_ENDPOINT=REPLACE_ACR_API_ENDPOINT
AAIS_ACR_LOGIN_SERVER=REPLACE_ENTERPRISE_VPC_LOGIN_SERVER
AAIS_ALIYUN_CLI=/usr/local/bin/aliyun
AAIS_ALIYUN_CLI_PROFILE=aais-ecs-role
AAIS_EXPECTED_MACHINE_ID_SHA256=REPLACE_WITH_ETC_MACHINE_ID_SHA256
AAIS_NGINX_CONFIG_FILE=/www/server/nginx/conf/nginx.conf
AAIS_EXPECTED_NGINX_CONFIG_SHA256=REPLACE_WITH_NGINX_CONFIG_SHA256
AAIS_NGINX_VHOST_FILE=/www/server/panel/vhost/nginx/aais.site.conf
AAIS_EXPECTED_NGINX_VHOST_SHA256=REPLACE_WITH_AAIS_VHOST_SHA256
AAIS_CANDIDATE_RECEIPT_DIR=/opt/aais/candidates
# Set both only when the runtime database provider is RDS.
AAIS_DATABASE_CA_FILE=
AAIS_EXPECTED_DATABASE_CA_SHA256=
AAIS_RUNTIME_ENV_FILE=/run/aais/current/runtime.env
AAIS_NGINX_BINARY=/www/server/nginx/sbin/nginx
AAIS_UPSTREAM_FILE=/opt/aais/nginx/upstream-active.conf
AAIS_STATE_FILE=/opt/aais/state/active-deployment.env
AAIS_OPERATION_LOCK_FILE=/opt/aais/state/deploy.lock
AAIS_ROTATION_PENDING_FILE=/opt/aais/state/secret-rotation.pending
AAIS_RECEIPT_DIR=/opt/aais/receipts
