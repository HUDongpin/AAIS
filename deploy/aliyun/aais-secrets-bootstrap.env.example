# Non-secret bootstrap binding. Install root:root mode 0600.
# The default file mode has no KMS instance fee. The Owner creates
# /etc/aais/secrets/runtime.env as the one regular root-owned 0400 source file.
# It includes a unique non-secret AAIS_SECRET_BUNDLE_VERSION for every rotation;
# worker.env is derived from the same snapshot and is never persisted here.
AAIS_SECRET_SOURCE=file
AAIS_ALIYUN_CLI=/usr/local/bin/aliyun
AAIS_ALIYUN_CLI_PROFILE=aais-ecs-role
AAIS_OPERATION_LOCK_FILE=/opt/aais/state/deploy.lock
AAIS_STATE_FILE=/opt/aais/state/active-deployment.env
AAIS_ROTATION_PENDING_FILE=/opt/aais/state/secret-rotation.pending

# Optional only after the Owner separately approves the current KMS price.
# AAIS_SECRET_SOURCE=kms
# AAIS_KMS_SECRET_NAME=REPLACE_AAIS_RUNTIME_BUNDLE_SECRET
# AAIS_KMS_API_ENDPOINT=REPLACE_KMS_API_ENDPOINT
