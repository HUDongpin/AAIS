# Copy to .env.local for local development. Do not put real production secrets here.

AAIS_SESSION_SECRET=local-dev-session-secret-change-me
AAIS_TRIAL_LOGIN_ENABLED=true

# Optional local/dev trial accounts. Production trial accounts must be learner
# smoke accounts only; teacher/admin access must use database users or OIDC.
# AAIS_TRIAL_ACCOUNTS_JSON=[{"id":"student-smoke","displayName":"Student Smoke","role":"student","password":{"algorithm":"scrypt","salt":"...","hash":"..."}}]
# Optional last-applied learner source for production account additions or rotations.
# Later records replace matching IDs from the sources above; keep this Production-only.
# AAIS_TRIAL_ADDITIONAL_ACCOUNTS_JSON=[{"id":"student-rotation","displayName":"Student Rotation","role":"student","password":{"algorithm":"scrypt","salt":"...","hash":"..."}}]

# Optional Postgres persistence. If omitted locally, AAIS uses .aais-data file storage.
# AAIS_DATABASE_URL=postgres://user:password@host:5432/aais
# AAIS_DATABASE_PROVIDER=neon
# AAIS_APP_BASE_URL=http://localhost:3000

# Optional restored/staging Neon branch used only for restore rehearsal evidence.
# Keep this in an ignored local env file such as .env.postgres-restore.local.
# AAIS_RESTORE_DATABASE_URL=postgres://user:password@restored-host:5432/aais
# AAIS_RESTORE_TARGET_PURPOSE=restored-staging
# AAIS_RESTORE_REHEARSAL_REPORT_PATH=./aais-postgres-restore-report.json

# Optional invite/password-reset email delivery for database-backed accounts.
# RESEND_API_KEY=replace-me
# AAIS_AUTH_EMAIL_FROM=CAAIS <no-reply@example.test>

# Optional default course/cohort for admin-created database users.
# AAIS_DEFAULT_COURSE_ID=cognitive-apprenticeship
# AAIS_DEFAULT_COHORT=default
# AAIS_RECOMMENDATIONS_ENABLED=true

# Optional staging/bootstrap database users. Use ignored local env files or
# provider env vars for the password values; the seed report redacts emails,
# passwords, and database URLs.
# AAIS_USER_SEED_APPROVED=false
# AAIS_SEED_TEACHER_PASSWORD=replace-me
# AAIS_SEED_STUDENT_PASSWORD=replace-me
# AAIS_SEED_USERS_JSON=[{"email":"teacher@example.test","displayName":"Teacher Smoke","role":"teacher","passwordEnv":"AAIS_SEED_TEACHER_PASSWORD"},{"email":"student@example.test","displayName":"Student Smoke","role":"student","passwordEnv":"AAIS_SEED_STUDENT_PASSWORD"}]

# Optional login lockout tuning.
# AAIS_LOGIN_RATE_LIMIT_MAX_FAILURES=5
# AAIS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# AAIS_LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# Optional LRS mirroring.
# LRS_ENDPOINT=https://lrs.example/xapi/statements
# LRS_USERNAME=example
# LRS_PASSWORD=example
# CRON_SECRET=local-cron-secret
# AAIS_LRS_OUTBOX_FLUSH_TOKEN=local-ops-token

# Optional readiness diagnostics bearer for full report access.
# AAIS_READINESS_BEARER_TOKEN=local-readiness-token
# Readiness defaults to traffic health. Use enterprise for fail-closed launch gates
# where external monitoring/LRS evidence is required.
# AAIS_READINESS_MODE=enterprise

# Optional Sentry monitoring. Create these in Sentry/Vercel; do not paste auth
# tokens into tracked files. Client/server/edge instrumentation is inert without
# NEXT_PUBLIC_SENTRY_DSN or SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project
# SENTRY_DSN=https://private@example.ingest.sentry.io/project
# SENTRY_ORG=example-org
# SENTRY_PROJECT=aais
# SENTRY_AUTH_TOKEN=sntrys_replace_me_in_vercel_or_ci_only
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# AAIS_SENTRY_ALERTS_CONFIGURED=false
# AAIS_UPTIME_LOGIN_CHECK_URL=https://uptime.example/aais-login
# AAIS_CRON_FAILURE_ALERTS_CONFIGURED=false

# Optional live AI provider. Without these, AAIS uses deterministic fallback guidance.
# AAIS_AI_PROVIDER=qwen
# DASHSCOPE_API_KEY=replace-me
# AAIS_AI_MODEL=qwen3.7-max
# AAIS_AI_TIMEOUT_MS=12000
# AAIS_AI_MAX_RETRIES=1
# AAIS_AI_DAILY_GUIDE_LIMIT=40
# AAIS_AI_EVAL_APPROVED=false

# Optional deployed smoke check.
# AAIS_SMOKE_BASE_URL=https://www.aais.site
# AAIS_SMOKE_TRIAL_ACCOUNT=replace-me
# AAIS_SMOKE_TRIAL_PASSWORD=replace-me
# AAIS_SMOKE_BLOCKED_TRIAL_ACCOUNT=Bobie
# AAIS_SMOKE_BLOCKED_TRIAL_PASSWORD=replace-with-retired-demo-password

# Optional staging/preview load sanity check. Use staging-only student accounts;
# known production hosts are refused and reports omit accounts/passwords/cookies.
# AAIS_LOAD_BASE_URL=https://aais-preview.example
# AAIS_LOAD_STUDENT_CREDENTIALS_JSON=[{"account":"student-1@example.test","password":"replace-me"}]
# AAIS_LOAD_TARGET_USERS=200
# AAIS_LOAD_CONCURRENCY=200
# AAIS_LOAD_MAX_P95_MS=2500
# AAIS_LOAD_OUTPUT=./aais-load-sanity.json
