# Copy to .env.local for local development. Do not put real production secrets here.

AAIS_SESSION_SECRET=local-dev-session-secret-change-me
# Stable, purpose-specific HMAC key for product analytics and xAPI pseudonyms.
# Keep it distinct from every session, worker, research, and provider secret.
# Do not rotate it as part of routine AAIS_SESSION_SECRET rotation.
# Generate a private 32-byte value encoded as canonical base64url without
# padding for every environment. Never copy a value from documentation/source.
# AAIS_PRODUCT_PSEUDONYM_SECRET=
AAIS_TRIAL_LOGIN_ENABLED=true

# Optional local/dev trial accounts. Production trial accounts must be learner
# smoke accounts only; teacher/admin access must use database users or OIDC.
# AAIS_TRIAL_ACCOUNTS_JSON=[{"id":"student-smoke","displayName":"Student Smoke","role":"student","password":{"algorithm":"scrypt","salt":"...","hash":"..."}}]
# Optional last-applied learner source for production account additions or rotations.
# Later records replace matching IDs from the sources above; keep this Production-only.
# AAIS_TRIAL_ADDITIONAL_ACCOUNTS_JSON=[{"id":"student-rotation","displayName":"Student Rotation","role":"student","password":{"algorithm":"scrypt","salt":"...","hash":"..."}}]

# Optional Postgres persistence. If omitted locally, AAIS uses .aais-data file storage.
# AAIS_DATABASE_URL=postgres://user:password@host:5432/aais
# AAIS_DATABASE_PROVIDER=neon
# AAIS_APP_BASE_URL=http://localhost:3000

# Optional restored/staging Neon branch used only for restore rehearsal evidence.
# Keep this in an ignored local env file such as .env.postgres-restore.local.
# AAIS_RESTORE_DATABASE_URL=postgres://user:password@restored-host:5432/aais
# AAIS_RESTORE_TARGET_PURPOSE=restored-staging
# AAIS_RESTORE_REHEARSAL_REPORT_PATH=./aais-postgres-restore-report.json

# Optional invite/password-reset email delivery for database-backed accounts.
# RESEND_API_KEY=replace-me
# AAIS_AUTH_EMAIL_FROM=CAAIS <no-reply@example.test>

# Optional default course/cohort for admin-created database users.
# AAIS_DEFAULT_COURSE_ID=cognitive-apprenticeship
# AAIS_DEFAULT_COHORT=default
# AAIS_RECOMMENDATIONS_ENABLED=true

# Optional staging/bootstrap database users. Use ignored local env files or
# provider env vars for the password values; the seed report redacts emails,
# passwords, and database URLs.
# AAIS_USER_SEED_APPROVED=false
# AAIS_SEED_TEACHER_PASSWORD=replace-me
# AAIS_SEED_STUDENT_PASSWORD=replace-me
# AAIS_SEED_USERS_JSON=[{"email":"teacher@example.test","displayName":"Teacher Smoke","role":"teacher","passwordEnv":"AAIS_SEED_TEACHER_PASSWORD"},{"email":"student@example.test","displayName":"Student Smoke","role":"student","passwordEnv":"AAIS_SEED_STUDENT_PASSWORD"}]

# Optional login lockout tuning.
# AAIS_LOGIN_RATE_LIMIT_MAX_FAILURES=5
# AAIS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# AAIS_LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# Optional legacy/product LRS mirroring. Never reuse these credentials for a
# controlled research run; research uses its own AAIS-only store below.
# LRS_ENDPOINT=https://lrs.example/xapi/statements
# LRS_USERNAME=example
# LRS_PASSWORD=example
# CRON_SECRET=local-cron-secret
# AAIS_LRS_OUTBOX_FLUSH_TOKEN=local-ops-token

# Controlled research-study pipeline. Research mode is Postgres-only and fails
# closed unless the identity key, app version, and immutable commit SHA exist.
# Generate the AES-256-GCM key outside the repository; never copy it into a
# database backup, report, log, screenshot, or tracked file.
# Leave this commented unless intentionally enabling the controlled study;
# research mode recognizes only the literal true value.
# AAIS_RESEARCH_MODE=true
# Fail closed if research mode is accidentally omitted on the dedicated study deployment.
# AAIS_RESEARCH_REQUIRED=true
# Dedicated research Postgres fact store; never reuse AAIS_DATABASE_URL here.
# AAIS_RESEARCH_DATABASE_URL=postgres://user:password@research-host:5432/aais_research
# AAIS_RESEARCH_DATABASE_INSTANCE_ID=aais-research-postgres-primary
# AAIS_RESEARCH_DATABASE_DRIVER=pg
# AAIS_RESEARCH_PROJECT_ID=aais
# AAIS_RESEARCH_STUDY_ID=aais-ca-pilot
# AAIS_RESEARCH_ENVIRONMENT=research
# Rehearsals roll back by default. Set true only for an approved --commit in the
# research environment.
# AAIS_RESEARCH_REHEARSAL_APPROVED=false
# AAIS_RESEARCH_REHEARSAL_MODE=false
# AAIS_RESEARCH_IDENTITY_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# AAIS_RESEARCH_IDENTITY_FINGERPRINT_KEY=replace-with-separate-stable-32-byte-base64-key
# AAIS_RESEARCH_PARTICIPANT_ACTOR_IDS=participant-account-01,participant-account-02
# AAIS_RESEARCH_IDENTITY_KEY_VERSION=v1
# Comma-separated authenticated actor ids recorded in the signed access register.
# AAIS_RESEARCH_PI_ACTOR_IDS=pi-actor-id
# AAIS_RESEARCH_DATA_CUSTODIAN_ACTOR_IDS=custodian-actor-id
# Signed allowlist for the de-identified per-event export; a researcher role alone is insufficient.
# AAIS_RESEARCH_EXPORT_ACTOR_IDS=approved-researcher-actor-id
# AAIS_RESEARCH_CONDITIONS=control,treatment
# AAIS_RESEARCH_LRS_NAMESPACE=https://www.aais.site/xapi/studies/aais-ca-pilot/research/v1
# AAIS_RESEARCH_LRS_STORE_ID=aais-research-clean-store
# AAIS_RESEARCH_LRS_ENDPOINT=https://aais-research-lrs.example/xapi/statements
# AAIS_RESEARCH_LRS_USERNAME=replace-with-dedicated-least-privilege-user
# AAIS_RESEARCH_LRS_PASSWORD=replace-with-dedicated-least-privilege-password
# Pinned provider Ed25519 verification key. SPKI is canonical DER encoded as base64.
# Formal collection requires both values; an approved rehearsal may omit them,
# but an unverifiable DELETE response can never become confirmed.
# AAIS_RESEARCH_LRS_RECEIPT_VERIFYING_KEY_ID=provider-ed25519-2026-01
# AAIS_RESEARCH_LRS_RECEIPT_VERIFYING_KEY_SPKI=replace-with-base64-der-spki
# AAIS_RESEARCH_EXPORT_ENABLED=false
# AAIS_RESEARCH_LRS_OUTBOX_FLUSH_TOKEN=local-research-ops-token
# Separate least-privilege bearer for scheduled retention; do not reuse flush credentials.
# AAIS_RESEARCH_RETENTION_TOKEN=local-research-retention-token
# IDs from the external scheduler configuration. All three jobs must issue POST,
# never GET, and use only their dedicated least-privilege bearer.
# AAIS_RESEARCH_LRS_EVENT_FLUSH_SCHEDULE_ID=aais-research-event-flush-v1
# AAIS_RESEARCH_LRS_DELETION_SCHEDULE_ID=aais-research-deletion-flush-v1
# AAIS_RESEARCH_RETENTION_SCHEDULE_ID=aais-research-retention-v1
# SHA-256 digests of redacted, signed launch receipts stored in the restricted
# operations register. A configured URL or script is not a receipt.
# AAIS_RESEARCH_DATABASE_ISOLATION_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_LRS_ISOLATION_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_LRS_ZERO_BASELINE_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_LRS_PUT_DELETE_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_BACKUP_POLICY_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_RESTORE_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_LEGACY_ARCHIVE_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_ACCESS_REGISTER_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_CONSENT_LEGAL_BASIS_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_DPA_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_DATA_REGION_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_DAILY_BACKUP_RECEIPT_SHA256=<64-lowercase-hex>
# AAIS_RESEARCH_BACKUP_DESTRUCTION_RECEIPT_SHA256=<64-lowercase-hex>
# Digest of the sanitized output from study:verify-governance-evidence.
# AAIS_RESEARCH_GOVERNANCE_MANIFEST_RECEIPT_SHA256=<64-lowercase-hex>
# The signed governance manifest must be reverified at least every 36 hours.
# The daily backup completion evidence must be no older than 36 hours, and the
# rolling 35-day destruction evidence must be no older than 45 days.
# AAIS_RESEARCH_GOVERNANCE_MANIFEST_VERIFIED_AT=2026-07-30T00:00:00.000Z
# AAIS_RESEARCH_GOVERNANCE_MANIFEST_VALID_UNTIL=2026-08-30T00:00:00.000Z
# AAIS_RESEARCH_DAILY_BACKUP_COMPLETED_AT=2026-07-30T00:00:00.000Z
# AAIS_RESEARCH_BACKUP_DESTRUCTION_OBSERVED_AT=2026-07-30T00:00:00.000Z
# AAIS_APP_VERSION=0.1.0
# AAIS_COMMIT_SHA=replace-with-full-commit-sha
# AAIS_RESEARCH_IDENTITY_RETENTION_DAYS=90
# AAIS_RESEARCH_RAW_TEXT_RETENTION_DAYS=180
# AAIS_RESEARCH_EVENT_RETENTION_DAYS=1825
# AAIS_RESEARCH_BACKUP_RETENTION_DAYS=35

# Read-only access to the historical mixed AAIS/MAIS pool. These credentials are
# used only to produce the 828-statement legacy inventory receipt; never use them
# for new research delivery.
# AAIS_LEGACY_LRS_ENDPOINT=https://legacy-lrs.example/xapi/statements
# AAIS_LEGACY_LRS_USERNAME=replace-with-read-only-user
# AAIS_LEGACY_LRS_PASSWORD=replace-with-read-only-password

# Optional readiness diagnostics bearer for full report access.
# AAIS_READINESS_BEARER_TOKEN=local-readiness-token
# Readiness defaults to traffic health. Use enterprise for fail-closed launch gates
# where external monitoring/LRS evidence is required.
# AAIS_READINESS_MODE=enterprise

# Optional Sentry monitoring. Create these in Sentry/Vercel; do not paste auth
# tokens into tracked files. Client/server/edge instrumentation is inert without
# NEXT_PUBLIC_SENTRY_DSN or SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project
# SENTRY_DSN=https://private@example.ingest.sentry.io/project
# SENTRY_ORG=example-org
# SENTRY_PROJECT=aais
# SENTRY_AUTH_TOKEN=sntrys_replace_me_in_vercel_or_ci_only
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# AAIS_SENTRY_ALERTS_CONFIGURED=false
# AAIS_UPTIME_LOGIN_CHECK_URL=https://uptime.example/aais-login
# AAIS_CRON_FAILURE_ALERTS_CONFIGURED=false

# Optional live AI provider. Without these, AAIS uses deterministic fallback guidance.
# Production Qwen must use an immutable dated snapshot model id; rolling aliases
# such as qwen3.8-max or qwen3.7-max are intentionally not approval-eligible.
# AAIS_AI_PROVIDER=qwen
# DASHSCOPE_API_KEY=replace-me
# AAIS_AI_MODEL=qwen3.7-max-2026-06-08
# AAIS_AI_THINKING_MODE=disabled
# AAIS_AI_TIMEOUT_MS=12000
# The signed snapshot evaluation binds maxRetries=0 for Production.
# AAIS_AI_MAX_RETRIES=0
# AAIS_AI_DAILY_GUIDE_LIMIT=1000
# Optional live-provider fallback chain. Complete fallback fields retain the
# legacy enabled behavior when this flag is absent. Set it explicitly to false
# to keep stored fallback settings dormant and out of runtime/readiness checks.
# AAIS_AI_FALLBACK_ENABLED=false
# AAIS_AI_FALLBACK_ENDPOINT=https://fallback.example/v1/chat/completions
# AAIS_AI_FALLBACK_API_KEY=replace-me
# AAIS_AI_FALLBACK_MODEL=immutable-fallback-model-id
# Enable a production fallback only with matching approved, signed fallback
# evaluation evidence (AAIS_AI_FALLBACK_EVAL_*).
# Production live inference also requires a signed evaluation whose snapshot,
# endpoint, runtime settings, A1-A4 bilingual coverage, prompt/CA/guardrail source
# hashes, manifest digest, key id, and Ed25519 trust root all match exactly.
# AAIS_AI_EVAL_APPROVED=false
# AAIS_AI_EVAL_VERSION=aais-qwen37-snapshot-20260823-v1
# The approved manifest is bundled in source. JSON/PATH are optional explicit
# overrides and fail closed when malformed or mismatched.
# AAIS_AI_EVAL_MANIFEST_SHA256=<64-lowercase-hex>
# AAIS_AI_EVAL_SIGNING_KEY_ID=aais-qwen37-snapshot-20260823-ed25519-v1
# AAIS_AI_EVAL_VERIFYING_KEY_SPKI=<base64-der-ed25519-public-key>
# AAIS_AI_EVAL_MANIFEST_PATH=/absolute/read-only/path/to-model-matched-eval.json

# Optional deployed smoke check.
# AAIS_SMOKE_BASE_URL=https://www.aais.site
# AAIS_SMOKE_TRIAL_ACCOUNT=replace-me
# AAIS_SMOKE_TRIAL_PASSWORD=replace-me
# AAIS_SMOKE_BLOCKED_TRIAL_ACCOUNT=Bobie
# AAIS_SMOKE_BLOCKED_TRIAL_PASSWORD=replace-with-retired-demo-password

# Optional staging/preview load sanity check. Use staging-only student accounts;
# known production hosts are refused and reports omit accounts/passwords/cookies.
# AAIS_LOAD_BASE_URL=https://aais-preview.example
# AAIS_LOAD_STUDENT_CREDENTIALS_JSON=[{"account":"student-1@example.test","password":"replace-me"}]
# AAIS_LOAD_TARGET_USERS=200
# AAIS_LOAD_CONCURRENCY=200
# AAIS_LOAD_MAX_P95_MS=2500
# AAIS_LOAD_OUTPUT=./aais-load-sanity.json
